# PostgreSQL
POSTGRES_USER=intent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=intent_monitor
DATABASE_URL=postgresql://intent:change_me@postgres:5432/intent_monitor

# Юзербот (аккаунт с my.telegram.org)
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# Путь к session-файлу внутри контейнера (volume ./data/session:/session)
TG_SESSION=/session/userbot

# Управляющий бот (BotFather)
BOT_TOKEN=123456:ABC-DEF
# Telegram user id админов через запятую
ADMIN_IDS=11111111
# id супергруппы-форума (с включёнными Topics), бот — админ с Manage Topics
FORUM_CHAT_ID=-1001234567890

# Классификация
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
# Сообщения короче этого — сразу skipped
MIN_TEXT_LEN=20

# Страховочная сверка юзербота
SYNC_INTERVAL_MIN=120
SYNC_CHAT_PAUSE_SEC=8

# Публикация
DEDUP_WINDOW_HOURS=48
PUBLISH_MIN_INTERVAL_SEC=3

# Ретеншн skipped-сообщений, дней
SKIPPED_RETENTION_DAYS=14
