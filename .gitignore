# Python
__pycache__/
*.pyc
.venv/

# Секреты и локальная конфигурация (любые варианты .env, кроме шаблона)
.env
.env.*
!.env.example

# Сессии Telegram (= auth-токены аккаунта)
*.session
*.session-journal

# Данные (БД Postgres, сессии, кэш)
data/

# Дампы БД — внутри тексты сообщений из чатов (PII).
# Легитимные .sql лежат только в db/migrations/, поэтому корневые .sql — под игнор.
/*.sql
*.dump
*.sql.gz

# Типовые секретохранилища
secrets*.json
credentials*.json
*.pem
*.key
